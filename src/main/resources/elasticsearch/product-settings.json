{
  "analysis": {
    "analyzer": {
      "ngram_analyzer": {
        "type":      "custom",
        "tokenizer": "ngram_tokenizer",
        "filter":    ["lowercase"]
      }
    },
    "tokenizer": {
      "ngram_tokenizer": {
        "type":     "ngram",
        "min_gram": 2,
        "max_gram": 4,
        "token_chars": ["letter", "digit"]
      }
    }
  },
  "index": {
    "max_ngram_diff": 3
  }
}